#!/bin/sh
# shortcut: local hook because GitHub Free blocks remote branch rulesets on private repos; replace with GitHub ruleset if upgraded to Pro or made public
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"

if [ "$branch" = "main" ]; then
  echo "error: direct commits to main are blocked; create a branch first." >&2
  exit 1
fi

if ! printf '%s\n' "$branch" | grep -Eq '^(([a-z0-9._-]+/)?lum-[0-9]+(-[a-z0-9._-]+)?|(chore|docs|ci)/[a-z0-9][a-z0-9._-]*)$'; then
  echo "error: branch '${branch:-(detached HEAD)}' must match Linear's gitBranchName (e.g. zvishrut/lum-12-short-slug) or chore|docs|ci/<slug>." >&2
  echo "Fetch the Linear issue's gitBranchName and run: git fetch origin && git checkout -B <gitBranchName> origin/main" >&2
  exit 1
fi

# Check only, so partially staged files are never rewritten behind the user's back.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "$staged" ]; then
  if ! printf '%s\n' "$staged" | xargs pnpm exec prettier --check --ignore-unknown --no-error-on-unmatched-pattern >/dev/null 2>&1; then
    echo "error: staged files are not formatted. Run: pnpm exec prettier --write <files>, then re-stage." >&2
    printf '%s\n' "$staged" | xargs pnpm exec prettier --list-different --ignore-unknown --no-error-on-unmatched-pattern >&2
    exit 1
  fi
fi
