{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "#/*": ["./src/*"],
      "#test/*": ["./test/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "e2e/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
