{
  "name": "@lumavault/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=@lumavault/dist dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "tsx src/db/ensure-schemas.ts && drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "auth:generate": "tsx src/tools/generate-auth-schema.ts",
    "auth:check": "tsx src/tools/generate-auth-schema.ts --check",
    "email:preview": "email dev --dir src/email/templates --port 3030"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.25",
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@hono/node-server": "^2.1.8",
    "@lumavault/sdk": "workspace:*",
    "@react-email/render": "^2.3.1",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@connectrpc/connect-web": "^2.3.0",
    "@react-email/ui": "^6.11.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "auth": "^1.7.25",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.21.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#/*": {
      "@lumavault/dist": "./dist/*",
      "default": "./src/*"
    }
  }
}
