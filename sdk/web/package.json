{
  "name": "@lumavault/sdk",
  "version": "0.1.0",
  "description": "LumaVault Web & TypeScript Client SDK (Connect-ES + SHA-256 Chunking)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "default": "./dist/gen/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "hash-wasm": "^4.13.0"
  },
  "devDependencies": {
    "@lumavault/test-gateway": "workspace:*",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
